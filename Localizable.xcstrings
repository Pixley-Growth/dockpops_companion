        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite la carpeta compartida de DockPops para que esta app pueda sincronizar tus Pops."
          }
        }
      }
    },
    "Anything you create or modify in DockPops appears here automatically." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
