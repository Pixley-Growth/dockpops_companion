    },
    "Pops you make or modify in DockPops will appear here automatically. Then drag the ones you want into the Dock." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pops, die du in DockPops erstellst oder änderst, erscheinen hier automatisch. Zieh dann die gewünschten ins Dock."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los Pops que crees o modifiques en DockPops aparecerán aquí automáticamente. Luego arrastra al Dock los que quieras."
          }
        }
      }
    },
